# Copy to .env and fill in (never commit .env)

# ---- LLM: set ONE of these (Claude is used if both are set, unless LLM_PROVIDER says otherwise)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant          # article summaries during ingest
GROQ_ANSWER_MODEL=llama-3.3-70b-versatile # chat answers + briefing
# LLM_PROVIDER=claude                    # or groq - optional override

# ---- Ingest service
INGEST_TOKEN=make_up_a_long_random_string  # n8n / orchestrator send it in X-Ingest-Token
INGEST_URL=http://127.0.0.1:8000

# ---- Agents / scheduler (optional)
GNEWS_API_KEY=            # free key from gnews.io adds GNews headlines to each agent
FETCH_EVERY_HOURS=3
BRIEFING_HOUR=7

# ---- RAG tuning (optional)
# RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2   # default; BAAI/bge-reranker-base scored lower in eval run 3
# RELEVANCE_MIN=0.10                     # below this best score the bot says "I don't have news on that."
